# Personal, machine-specific compose files at the repo root (e.g. a local
# docker-compose.<name>.yml for a live instance). The shipped templates live in
# examples/ and are not affected; a plain /docker-compose.yml is not matched.
/docker-compose.*.yml

# Local runtime state (dev data dir, server tokens written at the root by a
# local run, agent CLI configs)
