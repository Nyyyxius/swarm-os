{
  "name": "swarm-os",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Self-hosted web console that runs persistent teams of AI coding agents (Claude Code, Codex, Gemini, opencode) and lets you supervise them from a browser or phone.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nyyyxius/swarm-os.git"
  },
  "homepage": "https://github.com/Nyyyxius/swarm-os#readme",
  "bugs": {
    "url": "https://github.com/Nyyyxius/swarm-os/issues"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:claude": "pnpm --filter server exec tsx ../../scripts/verify-claude-code.ts",
    "verify:claude-sessionstart": "pnpm --filter server exec tsx ../../scripts/verify-claude-sessionstart.ts",
    "verify:codex": "pnpm --filter server exec tsx ../../scripts/verify-codex.ts",
    "verify:opencode": "pnpm --filter server exec tsx ../../scripts/verify-opencode.ts",
    "verify:gemini": "pnpm --filter server exec tsx ../../scripts/verify-gemini.ts",
    "models:sync": "pnpm --filter server exec tsx ../../scripts/sync-models.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  }
}
