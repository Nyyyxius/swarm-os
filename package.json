{
  "name": "swarm-os",
  "version": "0.10.4",
  "private": true,
  "type": "module",
  "description": "Plateforme web pour orchestrer des equipes de sessions Claude Code en mode autonome.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter server dev\" \"pnpm --filter web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:claude": "pnpm --filter server exec tsx ../../scripts/verify-claude-code.ts",
    "verify:claude-sessionstart": "pnpm --filter server exec tsx ../../scripts/verify-claude-sessionstart.ts",
    "verify:codex": "pnpm --filter server exec tsx ../../scripts/verify-codex.ts",
    "verify:opencode": "pnpm --filter server exec tsx ../../scripts/verify-opencode.ts",
    "verify:gemini": "pnpm --filter server exec tsx ../../scripts/verify-gemini.ts",
    "models:sync": "pnpm --filter server exec tsx ../../scripts/sync-models.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.1.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  }
}
